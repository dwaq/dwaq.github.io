        "kind" : "plus#comment",
        "object" : {
          "content" : "There&#39;s a total of 17 (7 segment pins + decimal point + a common cathode pin for each of the 9 digits). It&#39;s the type of LED display that was in the handheld calculators of the 70s.",
          "objectType" : "comment"
        },
        "plusoners" : {
          "totalItems" : 0
